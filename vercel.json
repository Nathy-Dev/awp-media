{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!assets/|images/|icons/|covers/|sermons\\.json|track-availability\\.json|manifest\\.json|robots\\.txt|sitemap\\.xml|sw\\.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "comment": "Vite fingerprints these filenames, so they can never go stale.",
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "comment": "Generated cover variants are content-addressed by slug, not by hash.",
      "source": "/covers/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "comment": "The admin commits this file on every upload, so keep the window short.",
      "source": "/sermons.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "comment": "Admin control centre holds no public content.",
      "source": "/dashboard",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
