{
  "name": "awp-media",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Apostles of the Word and Prayer Worldwide — sermon library.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-tracks.mjs && node scripts/optimize-images.mjs && node scripts/generate-sitemap.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "optimize-images": "node scripts/optimize-images.mjs",
    "generate-sitemap": "node scripts/generate-sitemap.mjs",
    "check-tracks": "node scripts/check-tracks.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
