local-config.js
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc data
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-modules
node_modules/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test
.env.local
.env.*.local
# ...but the template everyone copies from is not a secret and must be committed.
!.env.example

# Generated at build time (see the `prebuild` script) — never committed.
# `public/covers/` alone is ~3.4MB of WebP variants regenerated on every deploy,
# and the sitemap is derived from `sermons.json` plus the static route list.
dist/
public/covers/
public/sitemap.xml
public/track-availability.json
*.tsbuildinfo

# parcel-bundler cache (https://parceljs.org/)
.cache

# next.js build output
.next

# nuct.js build output
.nuxt

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/
