# Copy to `.env.local` for development, and set the same values in the Vercel
# project settings for production. Only variables prefixed `VITE_` reach the
# browser.

# Base URL of the download Worker in `cloudflare-worker/`, without a trailing
# slash. This is what supplies the `Content-Disposition` header that makes iOS
# Safari save a sermon instead of opening a player.
#
# Leave it unset and downloads fall back to the raw archive.org URL — which
# returns HTTP 500 for this library's item, so the site is broken without it.
#
#   local:      http://localhost:8787
#   production: https://awp-download.<your-subdomain>.workers.dev
#   later:      https://dl.awpwmedia.org
VITE_DOWNLOAD_BASE=

# archive.org item used when a track URL carries no item path. Defaults to
# `attitude5`, which is the item the whole current library lives in.
VITE_DEFAULT_ARCHIVE_ITEM=attitude5
